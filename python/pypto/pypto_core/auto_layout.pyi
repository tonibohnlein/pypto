"""Type stubs for PyPTO native C++ AutoLayout model, IR extractor, solver, and writer."""

from enum import Enum

from pypto.pypto_core import DataType
from pypto.pypto_core.backend import BackendType
from pypto.pypto_core.ir import MemorySpace, Program, TensorLayout, TileLayout, TileType, Type

class LayoutSpec:
    class Kind(Enum):
        Tensor = ...
        Tile = ...

    kind: Kind
    tensor_layout: TensorLayout
    blayout: TileLayout
    slayout: TileLayout
    fractal: int
    tag: str

    def __init__(self) -> None: ...
    @staticmethod
    def tensor(layout: TensorLayout) -> LayoutSpec: ...
    @staticmethod
    def nd() -> LayoutSpec: ...
    @staticmethod
    def dn() -> LayoutSpec: ...
    @staticmethod
    def nz() -> LayoutSpec: ...
    @staticmethod
    def tile(blayout: TileLayout, slayout: TileLayout, fractal: int = 512, tag: str = "") -> LayoutSpec: ...
    @staticmethod
    def row_major_flat() -> LayoutSpec: ...
    @staticmethod
    def col_major_flat() -> LayoutSpec: ...
    @staticmethod
    def row_bcast_flat() -> LayoutSpec: ...
    @staticmethod
    def fractal_nz() -> LayoutSpec: ...
    @staticmethod
    def fractal_zn() -> LayoutSpec: ...
    @staticmethod
    def fractal_acc_nz() -> LayoutSpec: ...
    def is_tensor(self) -> bool: ...
    def is_tile(self) -> bool: ...
    def short_name(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __lt__(self, other: LayoutSpec) -> bool: ...
    def __hash__(self) -> int: ...

class ValueNode:
    name: str
    shape: list[int]
    dtype: DataType
    memory_space: MemorySpace
    current_layout: LayoutSpec
    admissible_layouts: list[LayoutSpec]
    producer_op_id: str | None
    is_reusable_weight: bool
    is_external_output: bool
    @property
    def num_elements(self) -> int: ...
    @property
    def byte_size(self) -> int: ...
    def __init__(self) -> None: ...

class OperatorConfig:
    op_id: str
    op_name: str
    input_layouts: list[LayoutSpec]
    output_layout: LayoutSpec
    op_cost_cycles: float
    notes: str
    def __init__(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

class OperationNode:
    op_id: str
    op_name: str
    inputs: list[str]
    output: str
    invocations: int
    configs: list[OperatorConfig]
    def __init__(self) -> None: ...

class LayoutCostModel:
    expected_uses: int
    backend_type: BackendType | None
    resolved_arch_hint: str
    mte2_nz2nz_bytes_per_cycle: float
    mte2_nd2nz_bytes_per_cycle: float
    mte2_nd2nz_contiguous_bytes_per_cycle: float
    mte2_nd2nz_row_penalty_cycles: float
    mte2_nd2nz_sub512b_penalty_cycles: float
    mte2_l2_reread_discount: float
    l2_cache_line_bytes: int
    mte2_vec_bytes_per_cycle: float
    mte2_vec_strided_bytes_per_cycle: float
    mte3_vec_bytes_per_cycle: float
    mte3_vec_strided_bytes_per_cycle: float
    vec_strided_burst_penalty_cycles: float
    mte1_l1_to_l0_bytes_per_cycle: float
    mte1_l0a_bytes_per_cycle: float
    mte1_l0b_bytes_per_cycle: float
    mte1_transpose_penalty_cycles: float
    cube_macs_per_cycle: float
    cube_issue_overhead_cycles: float
    mad_fp32_passes: int | None
    vec_elements_per_cycle: float
    vec_reshape_metadata_cycles: float
    vec_transpose_fixed_cycles: float
    vec_vbrcb_fixed_cycles: float
    vec_vbrcb_cycles_per_row: float
    vec_row_expand_issue_cycles: float
    vec_unsupported_conversion_cycles: float
    fixpipe_acc_to_nd_bytes_per_cycle: float
    fixpipe_acc_to_nz_bytes_per_cycle: float
    fixpipe_drain_fixed_cycles: float
    fixpipe_odd_n1_penalty_cycles: float
    gm_pack_bytes_per_cycle: float
    gm_pack_fixed_cycles: float
    onchip_relayout_bytes_per_cycle: float
    allow_external_input_relayout: bool
    allow_external_output_relayout: bool

    def __init__(self) -> None: ...
    def target_arch(self) -> str: ...
    def gm_access_granularity_bytes(self) -> int: ...
    def supports_acc_nz_store(self, src_node: ValueNode, dst_node: ValueNode) -> bool: ...
    def estimate_vbrcb_cost(self, rows: int) -> float: ...
    def is_valid_load_config(
        self, src_node: ValueNode, dst_node: ValueNode, src_layout: LayoutSpec, dst_layout: LayoutSpec
    ) -> bool: ...
    def is_valid_vec_store_config(
        self, src_node: ValueNode, dst_node: ValueNode, src_layout: LayoutSpec, dst_layout: LayoutSpec
    ) -> bool: ...
    def is_valid_move_config(
        self, src_node: ValueNode, dst_node: ValueNode, src_layout: LayoutSpec, dst_layout: LayoutSpec
    ) -> bool: ...
    def effective_mte2_load_multiplier(
        self, src_node: ValueNode, dst_node: ValueNode, per_run_inv: float
    ) -> float: ...
    def estimate_load_cost(
        self, src_node: ValueNode, dst_node: ValueNode, src_layout: LayoutSpec, dst_layout: LayoutSpec
    ) -> float: ...
    def estimate_move_cost(
        self, src_node: ValueNode, dst_node: ValueNode, src_layout: LayoutSpec, dst_layout: LayoutSpec
    ) -> float: ...
    def estimate_matmul_cost(
        self, lhs_node: ValueNode, rhs_node: ValueNode, out_node: ValueNode
    ) -> float: ...
    def estimate_store_cost(
        self,
        src_node: ValueNode,
        dst_node: ValueNode,
        dst_layout: LayoutSpec,
        src_layout: LayoutSpec | None = None,
    ) -> float: ...
    def supports_vec_tile_conversion(
        self, val_node: ValueNode, src_layout: LayoutSpec, dst_layout: LayoutSpec
    ) -> bool: ...
    def estimate_conversion_cost(
        self, val_node: ValueNode, src_layout: LayoutSpec, dst_layout: LayoutSpec
    ) -> float: ...

class LayoutProblemInstance:
    values: dict[str, ValueNode]
    value_order: list[str]
    operations: list[OperationNode]
    cost_model: LayoutCostModel
    custom_conversion_costs: dict[str, dict[tuple[LayoutSpec, LayoutSpec], float]]
    forbid_unmaterializable_gm_conversions: bool

    def __init__(self) -> None: ...
    def add_value(self, node: ValueNode) -> None: ...
    def find_value(self, name: str) -> ValueNode | None: ...
    def estimate_conversion_cost(
        self, val_node: ValueNode, src_layout: LayoutSpec, dst_layout: LayoutSpec
    ) -> float: ...
    def set_custom_conversion_cost(
        self, value_name: str, src_layout: LayoutSpec, dst_layout: LayoutSpec, cost: float
    ) -> None: ...

class LayoutAssignment:
    value_layouts: dict[str, LayoutSpec]
    op_configs: dict[str, OperatorConfig]
    def __init__(self) -> None: ...

class CostBreakdown:
    assignment: LayoutAssignment
    total_cost_cycles: float
    operator_cost_cycles: float
    conversion_cost_cycles: float
    per_op_costs: dict[str, float]
    per_value_conversion_costs: dict[str, float]
    def __init__(self) -> None: ...

class LayoutSolverConfig:
    max_evaluations: int
    max_greedy_sweeps: int
    max_treewidth: int
    max_bag_states: int
    tolerance: float
    def __init__(self) -> None: ...
    def validate(self) -> None: ...

class LayoutConversion:
    value_name: str
    source_layout: LayoutSpec
    target_layout: LayoutSpec
    cost_cycles: float
    consumer_op_ids: list[str]
    is_boundary: bool
    def __init__(self) -> None: ...

class TreewidthStats:
    num_values: int
    num_operations: int
    num_movable_operations: int
    dataflow_treewidth: int
    primal_treewidth: int
    active_primal_treewidth: int
    max_bag_size: int
    max_active_bag_size: int
    max_bag_domain_product: int
    total_dp_states: int
    elimination_order: list[str]
    bags: list[list[str]]
    def __init__(self) -> None: ...

class LayoutSolverStats:
    evaluated_moves: int
    moves_applied: int
    greedy_sweeps: int
    initial_cost_cycles: float
    termination_reason: str
    treewidth: int
    active_treewidth: int
    def __init__(self) -> None: ...

class LayoutSolverResult:
    breakdown: CostBreakdown
    stats: LayoutSolverStats
    conversions: list[LayoutConversion]
    writeback_issues: list[str]
    treewidth_stats: TreewidthStats | None
    @property
    def assignment(self) -> LayoutAssignment: ...
    @property
    def total_cost_cycles(self) -> float: ...
    @property
    def writeback_assignment(self) -> LayoutAssignment: ...
    def __init__(self) -> None: ...

class IndexedProblem:
    class ValueInfo:
        @property
        def name(self) -> str: ...
        @property
        def producer_op(self) -> int | None: ...
        @property
        def participants(self) -> list[int]: ...
        @property
        def layouts(self) -> list[LayoutSpec]: ...
        @property
        def default_source_idx(self) -> int: ...
        @property
        def boundary_demand_mask(self) -> int: ...
        @property
        def boundary_counts(self) -> list[int]: ...
        @property
        def conv_costs(self) -> list[float]: ...

    class OpConfigUse:
        @property
        def value_id(self) -> int: ...
        @property
        def demand_mask(self) -> int: ...
        @property
        def layout_counts(self) -> list[tuple[int, int]]: ...

    class OpInfo:
        @property
        def op_id(self) -> str: ...
        @property
        def op_name(self) -> str: ...
        @property
        def invocations(self) -> int: ...
        @property
        def output_value(self) -> int: ...
        @property
        def costs(self) -> list[float]: ...
        @property
        def output_layout_indices(self) -> list[int]: ...
        @property
        def config_uses(self) -> list[list[IndexedProblem.OpConfigUse]]: ...

    def __init__(self, instance: LayoutProblemInstance) -> None: ...
    @property
    def num_values(self) -> int: ...
    @property
    def num_ops(self) -> int: ...
    @property
    def values(self) -> list[ValueInfo]: ...
    @property
    def ops(self) -> list[OpInfo]: ...
    @property
    def topo_order(self) -> list[int]: ...
    def find_op_by_id(self, op_id: str) -> int | None: ...
    def find_value_by_name(self, name: str) -> int | None: ...
    def initial_choices(self, initial: LayoutAssignment) -> list[int]: ...
    def instance(self) -> LayoutProblemInstance: ...

class IncrementalState:
    def __init__(self, problem: IndexedProblem, choices: list[int]) -> None: ...
    def gain(self, op_idx: int, new_choice: int) -> float: ...
    def apply(self, op_idx: int, new_choice: int) -> None: ...
    def to_assignment(self) -> LayoutAssignment: ...
    @property
    def cost(self) -> float: ...
    @property
    def choices(self) -> list[int]: ...
    @property
    def sources(self) -> list[int]: ...
    @property
    def demand_masks(self) -> list[int]: ...
    @property
    def counts(self) -> list[list[int]]: ...
    @property
    def source_costs(self) -> list[list[float]]: ...
    def problem(self) -> IndexedProblem: ...

class OrchCallAnalysis:
    class CallSite:
        @property
        def arg_names(self) -> list[str | None]: ...
        @property
        def multiplicity(self) -> int: ...

    @property
    def call_counts(self) -> dict[str, int]: ...
    @property
    def call_arg_names(self) -> dict[str, list[str | None]]: ...
    @property
    def call_sites(self) -> dict[str, list[CallSite]]: ...
    @property
    def call_order(self) -> dict[str, int]: ...
    @property
    def param_steps(self) -> dict[tuple[str, int], int]: ...
    @property
    def reshaped_names(self) -> set[str]: ...
    @property
    def nz_ineligible_names(self) -> set[str]: ...
    @property
    def dn_ineligible_names(self) -> set[str]: ...
    @property
    def internal_buffers(self) -> set[str]: ...

def c0_elements(dtype: DataType) -> int: ...
def try_c0_elements(dtype: DataType) -> int | None: ...
def dtype_byte_width_safe(dtype: DataType) -> int: ...
def dtype_byte_width(dtype: DataType) -> int: ...
def is_nz_compatible_shape(shape: list[int], dtype: DataType) -> bool: ...
def analyze_orchestration(program: Program) -> OrchCallAnalysis: ...
def effective_tile_layout(tile_type: TileType) -> LayoutSpec: ...
def extract_layout_instance(
    program: Program,
    cost_model: LayoutCostModel = ...,
    reusable_tensors: set[str] = ...,
) -> LayoutProblemInstance: ...
def apply_layout_assignment(program: Program, assignment: LayoutAssignment) -> Program: ...
def sync_call_return_type(call_type: Type, ret_types: list[Type]) -> Type: ...
def operator_cost_multiplier(instance: LayoutProblemInstance, op: OperationNode) -> float: ...
def evaluate_assignment(instance: LayoutProblemInstance, assignment: LayoutAssignment) -> CostBreakdown: ...
def enumerate_assignments(
    instance: LayoutProblemInstance, deduplicate: bool = True
) -> list[CostBreakdown]: ...
def compute_treewidth(instance: LayoutProblemInstance) -> TreewidthStats: ...
def solve_greedy(
    instance: LayoutProblemInstance,
    initial: LayoutAssignment | None = None,
    config: LayoutSolverConfig = ...,
) -> LayoutSolverResult: ...
def solve_treewidth_dp(
    instance: LayoutProblemInstance,
    config: LayoutSolverConfig = ...,
) -> LayoutSolverResult: ...
def solve_auto_layout(
    instance: LayoutProblemInstance,
    initial: LayoutAssignment | None = None,
    config: LayoutSolverConfig = ...,
) -> LayoutSolverResult: ...
